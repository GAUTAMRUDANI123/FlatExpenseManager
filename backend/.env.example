PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=flatapp
DB_PASSWORD=change-me
DB_NAME=flat_expense_manager

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Core business rule: the group contains five people.
MAX_GROUP_MEMBERS=5

# --- Exposure -------------------------------------------------------------
# Which proxies may set X-Forwarded-For. "loopback" is right when Cloudflare
# Tunnel runs on this same machine, which is what SETUP.md describes. Leave it
# alone unless the API sits behind a reverse proxy on a different host.
TRUST_PROXY=loopback

# Browser origins allowed to call the API, comma-separated. The Android client
# is not a browser and does not need this. Empty means no browser origin is
# allowed, which is the correct default for a mobile-only API.
CORS_ORIGIN=

# Failed sign-ins per IP per 15 minutes. Successful sign-ins do not count.
# Everyone in one flat shares a public IP, so this is a per-household budget.
RATE_LIMIT_AUTH=20

# Overall requests per IP per 15 minutes, across the whole API.
RATE_LIMIT_API=1000
