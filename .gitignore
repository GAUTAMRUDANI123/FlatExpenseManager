# --- Secrets and machine-specific config -----------------------------------
# .env holds DB_PASSWORD and JWT_SECRET. Never commit it; .env.example is the
# template that belongs in the repo.
.env
*.env
!.env.example
local.properties

# --- Build output ----------------------------------------------------------
build/
.gradle/
*.apk
*.aab
*.ap_
*.dex

# --- Dependencies ----------------------------------------------------------
node_modules/

# --- IDE -------------------------------------------------------------------
.idea/
*.iml
.vscode/
captures/

# --- Logs and OS cruft -----------------------------------------------------
*.log
Thumbs.db
.DS_Store

# --- Database dumps ---------------------------------------------------------
# Real data: member emails and bcrypt password hashes. Never commit these.
backend/backups/

# Kotlin compiler session files, written during a build
.kotlin/

# --- Release signing ---------------------------------------------------------
# The keystore and its passwords. Losing the keystore means never being able to
# update the app again; leaking it means someone else can publish as you.
# Neither belongs in a public repository.
*.jks
*.keystore
keystore.properties
